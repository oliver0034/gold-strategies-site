# ==========================================================
# Gold Strategies — Redirections 301 (refonte 2026)
# Genere depuis la table de migration des 92 URLs.
# LiteSpeed/Apache lit ce fichier nativement sur Hostinger.
# ==========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forcer HTTPS + non-www (a confirmer selon config domaine)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

